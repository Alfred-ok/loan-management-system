# Single-page app routing for Apache (cPanel / shared hosting).
# React Router handles URLs like /loaning/register in the browser, but on a
# refresh the server looks for that path on disk and returns 404. These rules
# send every request that is not a real file or folder to index.html instead.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve index.html directly
    RewriteRule ^index\.html$ - [L]

    # Real files (JS, CSS, images) and folders are served as-is
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Everything else goes to the React app (relative to this folder)
    RewriteRule ^ index.html [L]
</IfModule>

# Fallback when mod_rewrite is not available
<IfModule !mod_rewrite.c>
    FallbackResource /index.html
</IfModule>

# Always fetch a fresh index.html so users get new builds after a deploy
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    # Built assets have hashed names, so they can be cached for a long time
    <FilesMatch "\.(js|css|svg|png|jpg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
